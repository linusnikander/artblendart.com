{% comment %} Coaching2 Final CTA Section with Urgency {% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap');

  .c2-cta {
    background: linear-gradient(135deg, #1a1a2e 0%, #2d2d4a 100%);
    padding: 5rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .c2-cta::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -20%;
    width: 80%;
    height: 150%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .c2-cta::after {
    content: '';
    position: absolute;
    bottom: -50%;
    right: -20%;
    width: 60%;
    height: 120%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .c2-cta-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .c2-cta-urgency {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(239, 68, 68, 0.2);
    color: #fca5a5;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    animation: pulse 2s infinite;
  }

  .c2-cta-urgency svg {
    width: 1rem;
    height: 1rem;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .c2-cta h2 {
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    font-size: clamp(22px, 2.8vw, 26px);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.2px;
    color: #fff;
    margin-bottom: 1rem;
  }

  .c2-cta-subtitle {
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .c2-cta-benefits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .c2-cta-benefit {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    color: rgba(255, 255, 255, 0.9);
    font-size: 16px;
    font-weight: 400;
  }

  .c2-cta-benefit svg {
    width: 1.25rem;
    height: 1.25rem;
    color: #a78bfa;
  }

  .c2-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
    color: #fff;
    padding: 1.25rem 2.5rem;
    border-radius: 9999px;
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.1;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(124, 58, 237, 0.4);
    margin-bottom: 1.5rem;
  }

  .c2-cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(124, 58, 237, 0.5);
    color: #fff;
  }

  .c2-cta-button svg {
    width: 1.5rem;
    height: 1.5rem;
    transition: transform 0.3s ease;
  }

  .c2-cta-button:hover svg {
    transform: translateX(4px);
  }

  .c2-cta-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
  }

  .c2-cta-note svg {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 768px) {
    .c2-cta-benefits {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
  }
</style>

<section class="c2-cta" id="boka">
  <div class="c2-cta-container">
    {% if section.settings.urgency_text != blank %}
      <div class="c2-cta-urgency">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {{ section.settings.urgency_text }}
      </div>
    {% endif %}

    <h2>{{ section.settings.heading }}</h2>
    <p class="c2-cta-subtitle">{{ section.settings.subtitle }}</p>

    <div class="c2-cta-benefits">
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <div class="c2-cta-benefit" {{ block.shopify_attributes }}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{{ block.settings.text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <a href="{{ section.settings.cta_link }}" class="c2-cta-button">
      {{ section.settings.cta_text }}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>

    {% if section.settings.note != blank %}
      <div class="c2-cta-note">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {{ section.settings.note }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Coaching2 CTA",
  "settings": [
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency Badge Text",
      "default": "Begränsat antal platser"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Redo att börja din kreativa resa?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Ta första steget mot ett mer kreativt liv. Boka en kostnadsfri 15-minuters konsultation där vi pratar om dina drömmar, mål och hur jag kan stötta dig."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Boka gratis konsultation nu"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note Text",
      "default": "Coaching sker online via Teams – tillgängligt var du än är."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "15 minuters gratis konsultation"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coaching2 CTA",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "text": "15 minuters gratis konsultation"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Ingen förpliktelse"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Online – var du än befinner dig"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Personlig och trygg vägledning"
          }
        }
      ]
    }
  ]
}
{% endschema %}
