{% comment %} Coaching2 Testimonial Quote {% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap');

  .c2-testimonial {
    padding: 3rem 1.5rem;
    background: #fff;
  }

  .c2-testimonial-container {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .c2-testimonial-quote {
    font-family: 'Lora', serif;
    font-size: clamp(18px, 2.2vw, 22px);
    font-style: italic;
    font-weight: 400;
    color: #4a4a68;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .c2-testimonial-quote::before {
    content: '"';
  }

  .c2-testimonial-quote::after {
    content: '"';
  }

  .c2-testimonial-author {
    font-family: 'Lora', serif;
    font-size: 15px;
    font-weight: 600;
    color: #7c3aed;
    letter-spacing: 0.03em;
  }
</style>

<section class="c2-testimonial">
  <div class="c2-testimonial-container">
    <p class="c2-testimonial-quote">{{ section.settings.quote }}</p>
    {% if section.settings.author != blank %}
      <span class="c2-testimonial-author">— {{ section.settings.author }}</span>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Coaching2 Testimonial",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Jag litar på kompetensen Therese besitter inom det konstnärliga och kreativa, det är en trygghet att luta sig mot henne i samtalen och bolla idéer och få råd."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "Kim"
    }
  ],
  "presets": [
    {
      "name": "Coaching2 Testimonial"
    }
  ]
}
{% endschema %}
