{% comment %} Coaching2 Themes Section - 6 Theme Cards {% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap');

  .c2-themes {
    background: #fff;
    padding: 5rem 1.5rem;
  }

  .c2-themes-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .c2-themes-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .c2-themes-label {
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    color: #7c3aed;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .c2-themes h2 {
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    font-size: clamp(22px, 2.8vw, 26px);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.2px;
    color: #1a1a2e;
    margin-bottom: 1rem;
  }

  .c2-themes-header > p {
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #6b6b8a;
    max-width: 600px;
    margin: 0 auto;
  }

  .c2-themes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .c2-theme-card {
    background: linear-gradient(135deg, #f8f5ff 0%, #fff 100%);
    border: 1px solid rgba(139, 92, 246, 0.1);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s ease;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .c2-theme-card:nth-child(1) { animation-delay: 0.1s; }
  .c2-theme-card:nth-child(2) { animation-delay: 0.15s; }
  .c2-theme-card:nth-child(3) { animation-delay: 0.2s; }
  .c2-theme-card:nth-child(4) { animation-delay: 0.25s; }
  .c2-theme-card:nth-child(5) { animation-delay: 0.3s; }
  .c2-theme-card:nth-child(6) { animation-delay: 0.35s; }

  .c2-theme-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.3);
  }

  .c2-theme-icon {
    width: 4rem;
    height: 4rem;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(139, 92, 246, 0.2) 100%);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    transition: all 0.3s ease;
  }

  .c2-theme-card:hover .c2-theme-icon {
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
  }

  .c2-theme-icon svg {
    width: 2rem;
    height: 2rem;
    color: #7c3aed;
    transition: color 0.3s ease;
  }

  .c2-theme-card:hover .c2-theme-icon svg {
    color: #fff;
  }

  .c2-theme-card h3 {
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: #1a1a2e;
    margin-bottom: 0.75rem;
  }

  .c2-theme-card p {
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #6b6b8a;
    line-height: 1.6;
    margin: 0;
  }

  .c2-themes-cta {
    text-align: center;
    padding: 2.5rem;
    background: linear-gradient(135deg, #f8f5ff 0%, #f0ebff 100%);
    border-radius: 1.5rem;
  }

  .c2-themes-cta p {
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    color: #4a4a68;
    margin-bottom: 0.5rem;
    font-size: 16px;
    font-weight: 400;
  }

  .c2-themes-cta p:first-child {
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    font-weight: 600;
    color: #1a1a2e;
  }

  .c2-themes-cta a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
    color: #fff;
    padding: 1rem 2rem;
    border-radius: 9999px;
    font-family: 'Lora', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.1;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
    margin-top: 1.5rem;
  }

  .c2-themes-cta a:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(124, 58, 237, 0.4);
    color: #fff;
  }

  .c2-themes-cta a svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.3s ease;
  }

  .c2-themes-cta a:hover svg {
    transform: translateX(4px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<section class="c2-themes">
  <div class="c2-themes-container">
    <div class="c2-themes-header">
      <div class="c2-themes-label">{{ section.settings.label }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="c2-themes-grid">
      {% for block in section.blocks %}
        {% if block.type == 'theme' %}
          <div class="c2-theme-card" {{ block.shopify_attributes }}>
            <div class="c2-theme-icon">
              {% case block.settings.icon %}
                {% when 'chat' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                {% when 'sparkles' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                {% when 'palette' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                  </svg>
                {% when 'calendar' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                {% when 'heart' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                {% when 'academic' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path d="M12 14l9-5-9-5-9 5 9 5z" />
                    <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                  </svg>
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
              {% endcase %}
            </div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="c2-themes-cta">
      <p>{{ section.settings.cta_line1 }}</p>
      <p>{{ section.settings.cta_line2 }}</p>
      <a href="{{ section.settings.cta_link }}">
        {{ section.settings.cta_button_text }}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coaching2 Themes",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Vad vi kan utforska"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Teman anpassade efter dig"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Varje samtal anpassas helt efter dig – där du befinner dig i livet och i ditt skapande."
    },
    {
      "type": "text",
      "id": "cta_line1",
      "label": "CTA Line 1",
      "default": "Vet du inte vart du ska börja?"
    },
    {
      "type": "text",
      "id": "cta_line2",
      "label": "CTA Line 2",
      "default": "Det är helt okej. Vi utforskar det tillsammans under vår första konsultation."
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "CTA Button Text",
      "default": "Boka gratis konsultation"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link",
      
    }
  ],
  "blocks": [
    {
      "type": "theme",
      "name": "Theme Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "chat", "label": "Chat (Feedback)" },
            { "value": "sparkles", "label": "Sparkles (First Steps)" },
            { "value": "palette", "label": "Palette (Technique)" },
            { "value": "calendar", "label": "Calendar (Habits)" },
            { "value": "heart", "label": "Heart (Inner Journey)" },
            { "value": "academic", "label": "Academic (Portfolio)" }
          ],
          "default": "chat"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Bollplank & feedback"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Få konstruktiv respons på ditt skapande och din process"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coaching2 Themes",
      "blocks": [
        {
          "type": "theme",
          "settings": {
            "icon": "chat",
            "title": "Bollplank & feedback",
            "description": "Få konstruktiv respons på ditt skapande och din process"
          }
        },
        {
          "type": "theme",
          "settings": {
            "icon": "sparkles",
            "title": "Hitta ditt första steg",
            "description": "Börja utforska kreativt skapande på ditt sätt"
          }
        },
        {
          "type": "theme",
          "settings": {
            "icon": "palette",
            "title": "Teknik & formspråk",
            "description": "Utveckla material, teknik och ditt personliga uttryck"
          }
        },
        {
          "type": "theme",
          "settings": {
            "icon": "calendar",
            "title": "Kreativa vanor",
            "description": "Integrera skapande i din vardag på ett hållbart sätt"
          }
        },
        {
          "type": "theme",
          "settings": {
            "icon": "heart",
            "title": "Kreativitet som inre resa",
            "description": "Självutforskande och personlig utveckling genom konst"
          }
        },
        {
          "type": "theme",
          "settings": {
            "icon": "academic",
            "title": "Portfolio & konstskolor",
            "description": "Förberedelse för ansökningar och konstnärliga utbildningar"
          }
        }
      ]
    }
  ]
}
{% endschema %}
