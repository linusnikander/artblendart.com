{% comment %} Vetenskap (Science Behind Coaching) Placeholder Page {% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Sora:wght@600;700&display=swap');

  .vetenskap-page {
    background: linear-gradient(135deg, #f8f5ff 0%, #fff 100%);
    padding: 5rem 1.5rem;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .vetenskap-container {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .vetenskap-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .vetenskap-badge svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .vetenskap-container h1 {
    font-family: 'Sora', system-ui, sans-serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    line-height: 1.2;
    color: #1a1a2e;
    margin-bottom: 1.5rem;
  }

  .vetenskap-container p {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #4a4a68;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .vetenskap-container p.subtle {
    font-size: 15px;
    color: #6b6b8a;
  }

  .vetenskap-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
    color: #fff;
    padding: 1rem 2rem;
    border-radius: 9999px;
    font-family: 'Sora', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
    margin-top: 1rem;
  }

  .vetenskap-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(124, 58, 237, 0.4);
    color: #fff;
  }

  .vetenskap-cta svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.3s ease;
  }

  .vetenskap-cta:hover svg {
    transform: translateX(4px);
  }
</style>

<section class="vetenskap-page">
  <div class="vetenskap-container">
    <div class="vetenskap-badge">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
      </svg>
      Forskning & vetenskap
    </div>

    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.body }}</p>
    <p class="subtle">{{ section.settings.note }}</p>

    <a href="{{ section.settings.cta_link }}" class="vetenskap-cta">
      {{ section.settings.cta_text }}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Vetenskap",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vetenskapen bakom kreativ coaching"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Vi sammanställer forskning och vetenskapliga studier som visar hur kreativt skapande påverkar välmående, stresshantering och personlig utveckling. Innehållet publiceras snart.</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note text",
      "default": "Denna sida uppdateras snart med mer information."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Se våra coaching-paket"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [
    {
      "name": "Vetenskap"
    }
  ]
}
{% endschema %}
