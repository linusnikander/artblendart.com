</div>
</div>

<script>
(function(){
  document.addEventListener('click', function(e) {
    var ob = e.target.closest('[data-mp-open]');
    if (ob) { var m = document.getElementById(ob.getAttribute('data-mp-open')); if(m) m.classList.add('active'); return; }
    var cb = e.target.closest('[data-mp-close]');
    if (cb) { var m = document.getElementById(cb.getAttribute('data-mp-close')); if(m) m.classList.remove('active'); return; }
    var ov = e.target.closest('.mp-overlay');
    if (ov && e.target === ov) { ov.classList.remove('active'); }
  });
  document.addEventListener('keydown', function(e) { if(e.key==='Escape') document.querySelectorAll('.mp-overlay').forEach(function(o){o.classList.remove('active')}); });
})();
</script>

